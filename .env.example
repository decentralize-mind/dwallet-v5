# ═══════════════════════════════════════════════════════
# dWALLET ADMIN - SECURITY CONFIGURATION
# Copy to .env and fill in your actual values
# ═══════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────
# 🔐 DATABASE ENCRYPTION (CRITICAL)
# Encrypts 2FA secrets and sensitive data at rest
# ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# ───────────────────────────────────────────────────────
# 🛡️  IP WHITELIST (HIGH PRIORITY)
# Comma-separated list of allowed admin IP addresses
# ───────────────────────────────────────────────────────
# Get your IP from: https://api.ipify.org
# Example: ADMIN_ALLOWED_IPS=203.0.113.1,198.51.100.1
ADMIN_ALLOWED_IPS=your-admin-ip-address-here

# ───────────────────────────────────────────────────────
# 📧 ALERT NOTIFICATIONS (RECOMMENDED)
# Discord/Slack webhooks for security alerts
# ───────────────────────────────────────────────────────
# Discord: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# Slack: Channel Settings > Integrations > Add Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WEBHOOK_HERE

# Email alerts (for production with nodemailer)
ALERT_EMAIL=admin-security@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ───────────────────────────────────────────────────────
# 🔏 HMAC REQUEST SIGNING (CRITICAL OPERATIONS)
# Prevents tampering with contract operations
# ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REQUEST_SIGNING_SECRET=your-64-character-hmac-signing-secret-here

# ───────────────────────────────────────────────────────
# 🔑 API KEY ROTATION (AUTOMATED)
# Admin API keys expire after this many days
# ───────────────────────────────────────────────────────
API_KEY_EXPIRY_DAYS=90

# ───────────────────────────────────────────────────────
# 🌐 CORS CONFIGURATION
# Allowed origins for admin frontend
# ───────────────────────────────────────────────────────
# Development: http://localhost:5173
# Production: https://admin.yourdomain.com
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,https://admin.yourdomain.com

# ───────────────────────────────────────────────────────
# 🔐 JWT CONFIGURATION
# ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-128-character-jwt-secret-here
JWT_EXPIRY_HOURS=8

# ───────────────────────────────────────────────────────
# 🗄️  POSTGRESQL DATABASE
# ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/dwallet_admin

# ───────────────────────────────────────────────────────
# 🔒 SERVER CONFIGURATION
# ───────────────────────────────────────────────────────
NODE_ENV=production
ADMIN_SERVER_PORT=3001
HTTPS_ENABLED=true
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CERT_PATH=/path/to/ssl/certificate.crt

# ───────────────────────────────────────────────────────
# 📊 MONITORING & LOGGING
# ───────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/admin-security.log
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=365

# ───────────────────────────────────────────────────────
# ⚡ RATE LIMITING
# ───────────────────────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_CRITICAL=10
RATE_LIMIT_WINDOW_MS=900000

# ───────────────────────────────────────────────────────
# 🔔 ALERT THRESHOLDS
# ───────────────────────────────────────────────────────
ALERT_FAILED_LOGIN_THRESHOLD=3
ALERT_ON_NEW_IP=true
ALERT_ON_CRITICAL_ACTION=true
ALERT_ON_2FA_DISABLE=true
ALERT_ON_SETTINGS_CHANGE=true

# ═══════════════════════════════════════════════════════
# 🔧 SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════
#
# 1. Copy this file: cp .env.example .env
#
# 2. Generate encryption keys:
#    node -e "console.log('DB_KEY:', require('crypto').randomBytes(32).toString('hex'))"
#    node -e "console.log('HMAC_KEY:', require('crypto').randomBytes(32).toString('hex'))"
#    node -e "console.log('JWT_KEY:', require('crypto').randomBytes(64).toString('hex'))"
#
# 3. Get your IP address:
#    curl https://api.ipify.org
#
# 4. Create Discord webhook:
#    Discord > Server Settings > Integrations > Webhooks > New Webhook
#
# 5. Update DATABASE_URL with your PostgreSQL credentials
#
# 6. For production HTTPS:
#    sudo certbot certonly --standalone -d admin.yourdomain.com
#    SSL_KEY_PATH=/etc/letsencrypt/live/admin.yourdomain.com/privkey.pem
#    SSL_CERT_PATH=/etc/letsencrypt/live/admin.yourdomain.com/fullchain.pem
#
# 7. NEVER commit .env to version control!
#    echo ".env" >> .gitignore
#
# ═══════════════════════════════════════════════════════
