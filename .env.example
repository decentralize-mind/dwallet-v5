# ── dWallet v5 Environment Variables ─────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local to Git.

# ── RPC (required for live balances + DeFi) ───────────────────────────
# Multiple providers for failover and decentralization
# Free at https://infura.io → New Project → Ethereum → copy Project ID
# Required for: Real blockchain transactions, balance fetching, swap execution
VITE_INFURA_KEY=
VITE_ALCHEMY_KEY=  # Get from https://alchemy.com

# Additional RPC URLs (optional, for failover)
VITE_RPC_FALLBACK_1=https://rpc.ankr.com/eth
VITE_RPC_FALLBACK_2=https://eth.llamarpc.com
VITE_RPC_FALLBACK_3=https://ethereum-rpc.publicnode.com

# ── NFT Gallery (required for real NFTs) ─────────────────────────────
# Free at https://alchemy.com → Create App → Ethereum Mainnet → API Key
VITE_ALCHEMY_ETH=

# ── Transaction History (optional, increases history limit) ───────────
# Free at https://etherscan.io/apis (2 calls/sec without key still works)
VITE_ETHERSCAN_KEY=

# ── WalletConnect (required for dApp connections) ─────────────────────
# Free at https://cloud.walletconnect.com → New Project → copy ID
VITE_WALLETCONNECT_PROJECT_ID=

# ── MoonPay Fiat On-Ramp (optional, for Buy feature) ──────────────────
# Free at https://www.moonpay.com/dashboard → API Keys → Publishable Key
# Required for: Buy crypto with credit card/bank transfer
# Get test key at: https://sandbox.moonpay.com/
# Get live key at: https://www.moonpay.com/
VITE_MOONPAY_KEY=

# ── Vercel: Add all above in Project → Settings → Environment Variables ─
# Without keys: wallet runs in preview mode with mock data
# With keys: fully live on-chain
#
# ─── Security Enhancements (NEW) ─────────────────────────────────────
# Redis for production rate limiting (optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Threat Intelligence APIs (optional - enhances address screening)
VITE_CHAINALYSIS_KEY=  # Get from https://www.chainalysis.com/
VITE_TRM_LABS_KEY=     # Get from https://www.trmlabs.com/
#
# ─── NFT Membership System ────────────────────────────────────────────
# Deployed NFTMembership contract address (required for minting UI)
# Get this after running: npx hardhat run scripts/deploy-nft-membership.js
VITE_NFT_MEMBERSHIP_ADDRESS=

# ─── DEX Aggregator (optional, for best swap rates) ───────────────────
# Free tier available for each - provides multi-DEX routing
# 1inch: https://portal.1inch.dev (1000 requests/day free)
VITE_1INCH_API_KEY=

# 0x API: https://0x.org/docs/api (free tier available)
VITE_0X_API_KEY=

# CoinGecko: https://www.coingecko.com/api/pricing (free tier: 10-50 calls/min)
# Optional - used for USD price displays
VITE_COINGECKO_API_KEY=

# ─── IPFS Deployment (optional, for decentralized hosting) ────────────
# Pinata: https://pinata.cloud (1GB free)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Web3.storage: https://web3.storage (10GB free)
WEB3_STORAGE_TOKEN=

# DWT Token address (required if not deploying new token)
DWT_TOKEN_ADDRESS=

# Security Controller address (required if not deploying new controller)
SECURITY_CONTROLLER_ADDRESS=

# Monitoring & Alerts (optional)
SLACK_WEBHOOK_URL=         # For Slack notifications
ALERT_EMAIL=               # Comma-separated emails for alerts
ALERT_PHONE=               # Comma-separated phone numbers for SMS
DISCORD_WEBHOOK_URL=       # For Discord notifications
#
# Quick Setup Guide:
# 1. VITE_INFURA_KEY (REQUIRED for live features)
#    - Go to https://infura.io/register
#    - Create new project
#    - Copy Project ID from dashboard
#    - Supports: Ethereum, Polygon, Arbitrum, Base, BNB Chain
#
# 2. VITE_MOONPAY_KEY (OPTIONAL for Buy feature)
#    - Go to https://www.moonpay.com/business/get-started
#    - Sign up for developer account
#    - Get API key from dashboard
#    - Test mode works without approval
#
# 3. VITE_ALCHEMY_ETH (OPTIONAL for NFTs)
#    - Go to https://www.alchemy.com/
#    - Create free account
#    - Create app → Copy HTTP API key
#
# 4. VITE_ETHERSCAN_KEY (OPTIONAL for better tx history)
#    - Go to https://etherscan.io/myapikey
#    - Create free account
#    - Generate API key
