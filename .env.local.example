# ── RPC Provider (REQUIRED for live blockchain features) ──────────────
# Get free key at: https://infura.io/register
VITE_INFURA_KEY=

# ── MoonPay (OPTIONAL - for Buy crypto feature) ──────────────────────
# Get free test key at: https://sandbox.moonpay.com/
VITE_MOONPAY_KEY=

# ── WalletConnect (OPTIONAL - for dApp browser) ──────────────────────
# Get free key at: https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ── Alchemy (OPTIONAL - for NFT gallery) ─────────────────────────────
# Get free key at: https://www.alchemy.com/
VITE_ALCHEMY_ETH=

# ── Etherscan (OPTIONAL - for better transaction history) ────────────
# Get free key at: https://etherscan.io/myapikey
VITE_ETHERSCAN_KEY=
