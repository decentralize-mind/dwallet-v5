{
  "name": "dwallet",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port ${PORT:-3000} --host",
    "admin:server": "node server/admin-server.js",
    "backup": "./scripts/backup-admin.sh full",
    "backup:config": "./scripts/backup-admin.sh config",
    "backup:logs": "./scripts/backup-admin.sh logs",
    "restore": "./scripts/restore-admin.sh",
    "cron:install": "./scripts/setup-cron.sh install",
    "cron:remove": "./scripts/setup-cron.sh remove",
    "cron:status": "./scripts/setup-cron.sh status",
    "monitoring:status": "echo 'Check Sentry dashboard for monitoring status'",
    "deploy:preproduction": "node scripts/deploy-preproduction.js",
    "deploy:preprod": "npm run deploy:preproduction",
    "deploy:staging": "npm run deploy:preproduction",
    "compile": "hardhat run scripts/deploy.js --network sepolia",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage",
    "test:security": "node scripts/test-security-features.js",
    "test:compatibility": "node scripts/verify-compatibility.js",
    "test:all": "npm run test:security && npm run test:compatibility",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:arb": "hardhat run scripts/deploy.js --network arbitrum",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "interact": "hardhat run scripts/interact.js --network mainnet",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:mainnet": "hardhat verify --network mainnet",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "lint": "eslint .",
    "security": "semgrep --config=auto && snyk test",
    "audit": "npm audit",
    "contracts": "slither .",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@ledgerhq/hw-app-eth": "^7.7.0",
    "@ledgerhq/hw-transport-webusb": "^6.34.0",
    "@noble/hashes": "^1.6.1",
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "@sentry/browser": "^10.49.0",
    "@sentry/node": "^10.49.0",
    "@sentry/profiling-node": "^10.49.0",
    "@sentry/react": "^10.49.0",
    "@sentry/tracing": "^7.120.4",
    "@uniswap/sdk-core": "^7.13.0",
    "@uniswap/v3-sdk": "^3.30.0",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "@walletconnect/web3wallet": "^1.16.1",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "ethers": "^6.13.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "qrcode": "^1.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@pinata/sdk": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "globals": "^15.9.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.10",
    "nft.storage": "^7.2.0",
    "prettier": "^3.8.1",
    "solhint": "^6.1.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.2",
    "vite": "^6.0.5"
  }
}
